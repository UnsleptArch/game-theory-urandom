diff --git a/target/i386/tcg/int_helper.c b/target/i386/tcg/int_helper.c
index 46741d9..6a2c1a1 100644
--- a/target/i386/tcg/int_helper.c
+++ b/target/i386/tcg/int_helper.c
@@ -446,6 +446,39 @@ target_ulong HELPER(rdrand)(CPUX86State *env)
     Error *err = NULL;
     target_ulong ret;
 
+    /*
+     * game-theory-urandom demo hook: GT_POISON_RDRAND, if set in the QEMU
+     * process environment, seeds a deterministic splitmix64 stream (the hex
+     * u64 value is the seed) that is returned in place of real host
+     * randomness. A plain constant is rejected by the guest kernel's own
+     * boot-time RDRAND self-test (arch/x86/kernel/cpu/rdrand.c), which
+     * disables RDRAND outright if every sample is identical -- so this
+     * models a hypervisor that controls RDRAND output with values that look
+     * varied to that test but are entirely attacker-known in advance.
+     * See CLAUDE.md for the full threat model. Unset -> normal behavior.
+     */
+    {
+        static bool gt_active;
+        static uint64_t gt_state;
+        if (!gt_active) {
+            const char *poison = getenv("GT_POISON_RDRAND");
+            if (poison) {
+                gt_active = true;
+                gt_state = strtoull(poison, NULL, 16) | 1;
+            }
+        }
+        if (gt_active) {
+            uint64_t z = (gt_state += 0x9e3779b97f4a7c15ULL);
+            z = (z ^ (z >> 30)) * 0xbf58476d1ce4e5b9ULL;
+            z = (z ^ (z >> 27)) * 0x94d049bb133111ebULL;
+            z = z ^ (z >> 31);
+            ret = (target_ulong)z;
+            env->cc_src = CC_C;
+            env->cc_op = CC_OP_EFLAGS;
+            return ret;
+        }
+    }
+
     if (qemu_guest_getrandom(&ret, sizeof(ret), &err) < 0) {
         qemu_log_mask(LOG_UNIMP, "rdrand: Crypto failure: %s",
                       error_get_pretty(err));
