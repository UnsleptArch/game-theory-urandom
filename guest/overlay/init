#!/bin/busybox sh
bb=/bin/busybox
"$bb" mount -t proc proc /proc
"$bb" mount -t sysfs sys /sys
"$bb" mount -t devtmpfs dev /dev 2>/dev/null
"$bb" mount -t debugfs none /sys/kernel/debug 2>/dev/null
"$bb" mount -t tmpfs tmp /tmp
if [ -e /sys/firmware/qemu_fw_cfg/by_name/opt/seed/raw ]; then
  echo "GT: fw_cfg opt/seed present, $("$bb" wc -c < /sys/firmware/qemu_fw_cfg/by_name/opt/seed/raw) bytes"
else
  echo "GT: fw_cfg opt/seed NOT present"
fi
# Fix config: load module if present and requested (gt=1 on cmdline)
echo "GT: hwrng check: $("$bb" ls -la /dev/hwrng 2>&1)"
if "$bb" grep -qw gt=1 /proc/cmdline && [ -f /lib/modules/gt_urandom.ko ]; then
  "$bb" insmod /lib/modules/gt_urandom.ko && echo "GT: module loaded"
  for f in summary rdrand virtio_rng seed; do
    echo "== gt_urandom/$f =="
    "$bb" cat /sys/kernel/debug/gt_urandom/$f 2>&1
  done
fi
echo "GT: entropy_avail=$("$bb" cat /proc/sys/kernel/random/entropy_avail)"
"$bb" rm -f /tmp/k /tmp/k.pub
/usr/bin/ssh-keygen -q -t ed25519 -N '' -f /tmp/k
echo "GT-HOSTKEY: $(/usr/bin/ssh-keygen -lf /tmp/k.pub)"
"$bb" poweroff -f
