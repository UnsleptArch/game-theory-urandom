#!/bin/busybox sh
# Combined "crack + visually SSH in" demo init: brings up networking and a
# real sshd (Alpine's -- see below for why), but the host key it serves is
# generated by the REAL distro's OWN ssh-keygen binary selected via
# gt_distro= on the kernel cmdline, same as guest/overlay-multios/init.
#
# Why Alpine's sshd specifically: getting Arch's or Debian's own sshd
# running pulls in PAM, Kerberos, and audit libraries (checked directly --
# `ldd` on Arch's sshd-session showed libpam, libgssapi_krb5, libaudit,
# libkrb5, and more), which means PAM module .so files, nsswitch config,
# and a working pam_unix auth stack in this minimal initramfs -- a much
# larger and riskier lift than this demo's actual claim needs. The thing
# being demonstrated is "this distro's own real keygen, fed by the
# poisoned kernel pool, produces the key"; which daemon then serves that
# key over the wire is incidental. Alpine's sshd is already proven
# working (networking, privsep, devpts, pubkey auth) and serves whatever
# host key file it's pointed at regardless of which binary produced it.
bb=/bin/busybox
"$bb" mount -t proc proc /proc
"$bb" mount -t sysfs sys /sys
"$bb" mount -t devtmpfs dev /dev 2>/dev/null
"$bb" mount -t tmpfs tmp /tmp
"$bb" mkdir -p /dev/pts
"$bb" mount -t devpts devpts /dev/pts
"$bb" mkdir -p /var/empty /run/sshd
"$bb" chown root:root /var/empty
"$bb" chmod 711 /var/empty

# gt=1 on the cmdline loads gt_urandom_rs, same gate guest/overlay/init
# uses. console_verbose() inside the module itself (see
# kernel-module-rust/gt_urandom_rs.rs) forces its own pr_info!/pr_warn!
# detection trail through regardless of `quiet`, so nothing extra is
# needed here to surface that -- it just shows up live on this terminal
# once insmod runs. This one line is the only thing that needs to stand
# out visually: everything else the module prints is already loud on its
# own (POISONED SOURCE DETECTED via pr_warn!).
"$bb" mount -t debugfs none /sys/kernel/debug 2>/dev/null
if "$bb" grep -qw gt=1 /proc/cmdline && [ -f /lib/modules/gt_urandom_rs.ko ]; then
  "$bb" insmod /lib/modules/gt_urandom_rs.ko
  printf '\033[0;32m[*] gt_urandom_rs module loaded\033[0m\n'
fi
"$bb" grep -q "^sshd:" /etc/passwd || echo "sshd:x:100:100:sshd privsep:/var/empty:/sbin/nologin" >> /etc/passwd
"$bb" grep -q "^sshd:" /etc/group || echo "sshd:x:100:" >> /etc/group

DISTRO=$("$bb" sed -n 's/.*gt_distro=\([a-z]*\).*/\1/p' /proc/cmdline)
echo "[*] distro: $DISTRO"

echo "[*] bringing up network (user-mode NAT)"
"$bb" ip link set lo up 2>/dev/null || "$bb" ifconfig lo up
"$bb" ip link set eth0 up 2>/dev/null || "$bb" ifconfig eth0 up
"$bb" udhcpc -i eth0 -q -n 2>&1

"$bb" rm -f /etc/ssh/ssh_host_* /tmp/k /tmp/k.pub
case "$DISTRO" in
  alpine)
    /usr/bin/ssh-keygen -q -t ed25519 -N '' -f /etc/ssh/ssh_host_ed25519_key
    ;;
  arch)
    /opt/arch/lib64/ld-linux-x86-64.so.2 --library-path /opt/arch/usr/lib \
      /opt/arch/usr/bin/ssh-keygen -q -t ed25519 -N '' -f /etc/ssh/ssh_host_ed25519_key
    ;;
  debian)
    /opt/debian/lib64/ld-linux-x86-64.so.2 --library-path /opt/debian/usr/lib \
      /opt/debian/usr/bin/ssh-keygen -q -t ed25519 -N '' -f /etc/ssh/ssh_host_ed25519_key
    ;;
  *)
    echo "[*] unknown or missing gt_distro= on cmdline"
    "$bb" poweroff -f
    ;;
esac
echo "HostKey /etc/ssh/ssh_host_ed25519_key" >> /etc/ssh/sshd_config
echo "GT-HOSTKEY: $(/usr/bin/ssh-keygen -lf /etc/ssh/ssh_host_ed25519_key.pub)"

"$bb" sed -i 's/^root:!:/root:*:/' /etc/shadow
"$bb" chown root:root /root
"$bb" chmod 700 /root
"$bb" mkdir -p /root/.ssh
"$bb" chown root:root /root/.ssh
"$bb" chmod 700 /root/.ssh
"$bb" cp /opt/demo-authorized_keys /root/.ssh/authorized_keys
"$bb" chown root:root /root/.ssh/authorized_keys
"$bb" chmod 600 /root/.ssh/authorized_keys

echo "[*] network + login ready"
/usr/sbin/sshd -D -e &
wait
echo "[*] sshd exited -- idling"
while true; do "$bb" sleep 3600; done
